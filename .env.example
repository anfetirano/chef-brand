# Public Supabase configuration. The publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Creative Room
STUDIO_ENABLED=false
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STUDIO_INVITE_SECRET=replace-with-at-least-32-random-characters
